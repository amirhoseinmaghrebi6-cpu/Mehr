# M2smart board defaults (ESP-IDF v5.4).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Root certificates for HTTPS to our own server (a bought, publicly trusted certificate).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# The setup page sends a form; allow its headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# A new firmware from an update is kept only once it has proven itself (main/ota.c).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
