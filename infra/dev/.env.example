# Copy to infra/dev/.env (gitignored) before running `pnpm infra:up`.
# Local development values only. Never reuse them anywhere else.

# PostgreSQL superuser and default database of the dev cluster.
POSTGRES_USER=m2smart
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=m2smart

# Host ports. All are bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=55432
MQTT_HOST_PORT=18830
KRATOS_PUBLIC_HOST_PORT=4433

# Ory Kratos (auth). Generate each with: openssl rand -hex 16  (hex only; it goes into a URL)
KRATOS_DB_PASSWORD=change-me-hex-only
# Session cookie signing key: any long random string.
KRATOS_SECRETS_COOKIE=change-me-at-least-32-random-characters
# Encryption key: exactly 32 characters (openssl rand -hex 16 gives 32).
KRATOS_SECRETS_CIPHER=change-me-exactly-32-characters!
