# Copy to infra/prod/.env (gitignored) on the server. Every value marked "random" must be new and
# unique: generate each with `openssl rand -hex 32` (or -hex 16 where noted). Never reuse dev values.

# The site's domain (no https://, no slash). The bought certificate must be for this name.
M2SMART_DOMAIN=m2smart.ir

# The operators: mobile numbers (comma-separated) that see the admin panel at /admin.
PLATFORM_ADMIN_PHONES=

# PostgreSQL superuser: used only by the migration and Kratos setup jobs and the backups.
POSTGRES_USER=m2smart
POSTGRES_PASSWORD=random
POSTGRES_DB=m2smart
# The API's own login (m2_api) and the owner of the app's tables (m2_migrator). Hex only: they go
# into a URL.
M2_API_DB_PASSWORD=random-hex
M2_MIGRATOR_DB_PASSWORD=random-hex

# Ory Kratos (sign-in).
KRATOS_DB_PASSWORD=random-hex
KRATOS_SECRETS_COOKIE=random
# Exactly 32 characters: openssl rand -hex 16
KRATOS_SECRETS_CIPHER=random-hex-16
KRATOS_WEBHOOK_SECRET=random

# The API's account on the broker (it creates the boards' accounts).
MQTT_API_USERNAME=m2-api
MQTT_API_PASSWORD=random

# SMS: FarazSMS / IranPayamak. The key is secret: keep it only in this file on the server.
SMS_API_KEY=
SMS_SENDER=90008361
SMS_PATTERN_CODE=
SMS_PATTERN_INVITATION=

# The demo for customer presentations: sample data only, never a real home.
M2SMART_DEMO_USERNAME=demo@m2smart.local
M2SMART_DEMO_PASSWORD=M2smart-Demo-2026!
M2SMART_DEMO_SESSION_SECRET=random

# Host ports. 8883 is the boards' MQTT over TLS.
HTTP_PORT=80
HTTPS_PORT=443
MQTTS_PORT=8883
