# Copy to .env.local (gitignored).

# Sign-in provider: "kratos" (self-hosted, default) or "supabase" (development only, removed in Phase 2G).
M2SMART_AUTH_PROVIDER=kratos
# Kratos public API, called only by the Next.js server (never by the browser).
KRATOS_PUBLIC_URL=http://127.0.0.1:4433
# M2smart API, called by the Next.js server (/v1/me) and proxied for the browser as /api/v1/*.
M2SMART_API_INTERNAL_URL=http://127.0.0.1:4000

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only with M2SMART_AUTH_PROVIDER=supabase:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key

# Public credentials for the isolated, sample-data demo account. Never use these for a real user.
M2SMART_DEMO_ENABLED=true
M2SMART_DEMO_USERNAME=demo@m2smart.local
M2SMART_DEMO_PASSWORD=M2smart-Demo-2026!

# Production demo access is disabled unless an isolated sandbox and unique signing key are configured.
M2SMART_DEMO_PRODUCTION_SANDBOX=false
M2SMART_DEMO_SESSION_SECRET=
