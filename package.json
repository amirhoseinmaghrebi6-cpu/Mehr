{
  "name": "m2smart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose -f infra/dev/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/dev/compose.yaml down",
    "infra:reset": "docker compose -f infra/dev/compose.yaml down -v --remove-orphans && docker compose -f infra/dev/compose.yaml up -d --wait",
    "api:dev": "pnpm --filter @m2smart/api dev",
    "db:migrate": "pnpm --filter @m2smart/api db:migrate",
    "db:test": "pnpm --filter @m2smart/api db:test",
    "db:seed": "pnpm --filter @m2smart/api db:seed",
    "dev:board": "pnpm --filter @m2smart/api dev:board"
  },
  "dependencies": {
    "@m2smart/contracts": "workspace:*",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
