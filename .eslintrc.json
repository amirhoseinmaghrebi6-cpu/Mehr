{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@supabase/*"],
            "message": "Auth providers are private to lib/auth/adapters. Use the AuthGateway from \"@/lib/auth\"."
          },
          {
            "group": ["@/lib/auth/adapters/*", "**/lib/auth/adapters/*"],
            "message": "Adapters are private. Import from \"@/lib/auth\"."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["lib/auth/**/*.ts"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
