# Copy to backend/.env.local (gitignored). Backend-only: never load these into the Next.js app.

# --- M2smart API (pnpm api:dev) ---
# Set to "development" locally: development-only routes and, without SMS_API_KEY, SMS codes are
# logged instead of sent. Leave unset or "production" anywhere else.
NODE_ENV=development
# The API's only database login: m2_api, with the password set by M2_API_DB_PASSWORD below.
DATABASE_URL=postgres://m2_api:<M2_API_DB_PASSWORD>@127.0.0.1:15432/m2smart
# Optional (defaults shown).
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_POOL_MAX=10
LOG_LEVEL=info
# Kratos public API (session checks).
KRATOS_PUBLIC_URL=http://127.0.0.1:4433
# Kratos admin API, used only by the operator's panel to block and delete accounts.
KRATOS_ADMIN_URL=http://127.0.0.1:4434
# The operators: mobile numbers (comma-separated) that see the admin panel at /admin.
PLATFORM_ADMIN_PHONES=
# Development only (needs NODE_ENV=development): simulated hub and ESP32 boards confirm commands for
# boards whose hardware id starts with DEV- (pnpm db:seed, pnpm dev:board). Never in production.
M2SMART_DEV_BOARD_SIMULATOR=true
# Shared secret for Kratos webhooks; must equal KRATOS_WEBHOOK_SECRET in infra/dev/.env.
# Without it the identity webhook is off (GET /v1/me still creates missing users), and so is the
# SMS route Kratos sends login codes to (POST /internal/kratos/sms).
KRATOS_WEBHOOK_SECRET=

# --- SMS: FarazSMS / IranPayamak web service ---
# Without SMS_API_KEY, development only logs messages ("DEV SMS (not sent)") and production cannot
# send login codes. The key is secret: keep it only here, never in git or chat.
SMS_API_KEY=
# The sender line for patterns (GET /ws/v1/lines/accessible), e.g. 90008361.
SMS_SENDER=
# Codes of the approved patterns: login code (variable %code%) and invitation (%name%, %home%).
SMS_PATTERN_CODE=
SMS_PATTERN_INVITATION=
# Optional (default shown).
# SMS_API_URL=https://api.iranpayamak.com

# --- Self-hosted PostgreSQL (pnpm db:migrate / db:test / db:seed) ---
# Superuser URL of the dev cluster from infra/dev (user, password and db from infra/dev/.env).
DATABASE_ADMIN_URL=postgres://m2smart:<POSTGRES_PASSWORD>@127.0.0.1:15432/m2smart
# Optional login passwords the bootstrap sets on the m2_api and m2_migrator roles.
M2_API_DB_PASSWORD=
M2_MIGRATOR_DB_PASSWORD=
# Optional email for the dev user created by pnpm db:seed (default dev@m2smart.local).
SEED_DEV_USER_EMAIL=

# The MQTT broker the ESP32 boards connect to. Username and password are MQTT_API_USERNAME and
# MQTT_API_PASSWORD from infra/dev/.env. Without MQTT_URL the API runs with no board connection.
MQTT_URL=mqtt://127.0.0.1:18830
MQTT_USERNAME=m2-api
MQTT_PASSWORD=change-me-to-a-long-random-value
