# Copy to backend/.env.local (gitignored). Backend-only: never load these into the Next.js app.

# --- Self-hosted PostgreSQL (pnpm db:migrate / db:test / db:seed) ---
# Superuser URL of the dev cluster from infra/dev (user, password and db from infra/dev/.env).
DATABASE_ADMIN_URL=postgres://m2smart:<POSTGRES_PASSWORD>@127.0.0.1:55432/m2smart
# Optional login passwords the bootstrap sets on the m2_api and m2_migrator roles.
M2_API_DB_PASSWORD=
M2_MIGRATOR_DB_PASSWORD=
# Optional email for the dev user created by pnpm db:seed (default dev@m2smart.local).
SEED_DEV_USER_EMAIL=

# --- Legacy Supabase seed (pnpm seed:phase1), removed in Phase 2G ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Existing, email-confirmed Supabase Auth user that receives the seeded "tehran" property.
PHASE1_TEST_USER_EMAIL=
